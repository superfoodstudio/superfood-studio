PINATA_GATEWAY_TOKEN=

# Pinata - Client-side (public)
NEXT_PUBLIC_PINATA_GATEWAY_URL=https://your-gateway.mypinata.cloud

# Stripe - Server-side
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
