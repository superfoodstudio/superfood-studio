// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id               String    @id @default(auto()) @map("_id") @db.ObjectId
  email            String    @unique
  firstName        String?
  lastName         String?
  role             Role      @default(SUBSCRIBER)
  billingAddress   Address?
  shippingAddress  Address?
  stripeCustomerId String?   // Stripe customer ID
  subscription     Subscription?
  orders           Order[]
  cart             Cart?
  recipeRatings    RecipeRating[]
  productRatings   ProductRating[]
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

model Recipe {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  name            String
  slug            String   @unique
  description     String
  category        String   // food, beauty, wellness
  isPublished     Boolean  @default(false)
  isFeatured      Boolean  @default(false)
  mediaUrl        String   // IPFS URL from Pinata
  previewImageUrl String?  // Optional preview image for recipe cards
  ingredients     String?   // Rich text HTML content for ingredients
  instructions    String?   // Rich text HTML content for instructions
  uploadDate      DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  comments        Comment[]
  ratings         RecipeRating[]
}

model Comment {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  content   String
  author    String   // User's name or email
  email     String?  // Optional email for notifications
  recipe    Recipe   @relation(fields: [recipeId], references: [id])
  recipeId  String   @db.ObjectId
  isHidden  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SiteSettings {
  id                 String   @id @default(auto()) @map("_id") @db.ObjectId
  homepageVideoUrl   String?
  weeklyGroceryList  String?  // Rich text content for weekly grocery list
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model Product {
  id              String    @id @default(auto()) @map("_id") @db.ObjectId
  name            String    @unique
  slug            String    @unique
  description     String
  photoUrl        String
  videoUrl        String?
  price           Float
  category        String
  tags            String[]
  inventory       Int       @default(0)
  isActive        Boolean   @default(true)
  isArchived      Boolean   @default(false)  // Soft delete flag
  isFeatured      Boolean   @default(false)
  // Stripe integration
  stripeProductId String?   @unique  // ID of the corresponding product in Stripe
  stripePriceId   String?   // ID of the default price in Stripe
  // Relations
  orderItems      OrderItem[]
  cartItems       CartItem[]
  ratings         ProductRating[]
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model Cart {
  id        String     @id @default(auto()) @map("_id") @db.ObjectId
  userId    String?    @db.ObjectId @unique
  user      User?      @relation(fields: [userId], references: [id])
  items     CartItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  guestId   String?    // For non-authenticated users
}

model CartItem {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  cartId    String   @db.ObjectId
  cart      Cart     @relation(fields: [cartId], references: [id])
  productId String   @db.ObjectId
  product   Product  @relation(fields: [productId], references: [id])
  quantity  Int
  price     Float
}

model Order {
  id              String    @id @default(auto()) @map("_id") @db.ObjectId
  user            User      @relation(fields: [userId], references: [id])
  userId          String    @db.ObjectId
  items           OrderItem[]
  status          OrderStatus
  total           Float
  shippingAddress Address?  // Shipping address at time of order
  stripeSessionId String?   // Stripe checkout session ID
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model OrderItem {
  id              String    @id @default(auto()) @map("_id") @db.ObjectId
  order           Order     @relation(fields: [orderId], references: [id])
  orderId         String    @db.ObjectId
  product         Product   @relation(fields: [productId], references: [id])
  productId       String    @db.ObjectId
  quantity        Int
  price           Float     // Price at time of purchase
}

model Subscription {
  id                   String    @id @default(auto()) @map("_id") @db.ObjectId
  user                 User      @relation(fields: [userId], references: [id])
  userId               String    @db.ObjectId @unique
  status               SubscriptionStatus
  plan                 Plan
  startDate            DateTime
  endDate              DateTime?
  // Stripe integration
  stripeSubscriptionId String? @unique
  stripePriceId        String?
  stripeCustomerId     String?
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean   @default(false)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
}

type Address {
  street          String
  city            String
  state           String
  zipCode         String
  country         String
}

enum Role {
  ADMIN
  SUBSCRIBER
  PUBLIC
}

enum OrderStatus {
  PENDING
  PROCESSING
  DELIVERED
  CANCELED
}

enum SubscriptionStatus {
  ACTIVE
  PENDING
  CANCELED
  EXPIRED
}

enum Plan {
  MONTHLY
  YEARLY
}

// Rating models
model RecipeRating {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  rating    Int      // 1-5 star rating
  user      User     @relation(fields: [userId], references: [id])
  userId    String   @db.ObjectId
  recipe    Recipe   @relation(fields: [recipeId], references: [id])
  recipeId  String   @db.ObjectId
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Ensure one rating per user per recipe
  @@unique([userId, recipeId])
}

model ProductRating {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  rating    Int      // 1-5 star rating
  user      User     @relation(fields: [userId], references: [id])
  userId    String   @db.ObjectId
  product   Product  @relation(fields: [productId], references: [id])
  productId String   @db.ObjectId
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Ensure one rating per user per product
  @@unique([userId, productId])
}
