{
  "buildCommand": "prisma generate && next build --no-lint",
  "env": {
    "NEXT_CONFIG_OUTPUT_TRACING": "false",
    "NODE_OPTIONS": "--max-old-space-size=4096"
  },
  "functions": {
    "src/app/api/graphql/route.ts": {
      "maxDuration": 30,
      "memory": 1024
    },
    "src/app/api/**/*.ts": {
      "maxDuration": 15
    }
  },
  "rewrites": [
    {
      "source": "/api/graphql",
      "destination": "/api/graphql"
    }
  ]
} 